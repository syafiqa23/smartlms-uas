# ============================================================
# Smart LMS — Environment Variables Template
# Salin file ini ke .env dan sesuaikan nilainya sebelum deploy
# ============================================================

# ------------------------------------------
# Django Core
# ------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-of-at-least-50-characters
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# Production database URL (Neon). Leave empty for local Docker PostgreSQL.
DATABASE_URL=

# ------------------------------------------
# Database — PostgreSQL
# ------------------------------------------
# PostgreSQL settings are used by both the database and Django containers.
POSTGRES_DB=smart_lms
POSTGRES_USER=smart_lms_user
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ------------------------------------------
# Docker Runtime
# ------------------------------------------
RUN_MIGRATIONS=False
RUN_COLLECTSTATIC=True
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=120
PORT=8000
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# ------------------------------------------
# Media & Static
# ------------------------------------------
MEDIA_URL=/media/
STATIC_URL=/static/
